# Local development defaults. Copy to .env. Never commit real credentials.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://airqa:airqa_dev_only@localhost:5433/airqa
TEST_DATABASE_URL=postgresql+psycopg://airqa:airqa_dev_only@localhost:5433/airqa_test
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_NAME=airqa_session
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
LOG_LEVEL=INFO
SEED_ADMIN_PASSWORD=change-me-locally
SEED_PARTICIPANT_PASSWORD=change-me-locally

# Frontend (empty = same origin via the Vite /api proxy)
VITE_API_BASE_URL=

# Playwright
BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# Login throttling (ADR-012)
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_IP=20

# Serve the built SPA from FastAPI (set in the Docker image; leave false for local Vite dev)
SERVE_FRONTEND=false
